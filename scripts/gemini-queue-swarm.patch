+def worker_answer(thread_id, run_id=None):
+    # A desktop session may spend time waiting behind other workers.
+    while True:
+        with urllib.request.urlopen(f"{BASE}/api/threads/{thread_id}", timeout=30) as response:
+            detail = json.load(response)
+        runs = detail["runs"]
+        run = (next((r for r in runs if r["id"] == run_id), None) if run_id
+               else min(runs, key=lambda r: r["ordinal"], default=None))
+        if run and run["status"] == "completed":
+            for item in reversed(detail["items"]):
+                if item["run_id"] == run["id"] and item["kind"] == "assistant_message":
+                    return item["payload"]["text"]
+            raise RuntimeError("completed Gemini worker run has no answer")
+        if run and run["status"] not in ("running", "queued"):
+            raise RuntimeError(run.get("error_message") or run["status"])
+        time.sleep(2)
+
